{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organize",
  "version": "0.2.0",
  "identifier": "com.organize.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @organize/web dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://organize-web.vercel.app"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Organize",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMkVDRjZGQzZCNzJFQTYKUldTbUxyZkdiODh1Zlc4ZVhQU3orYVRacDZXS1V0RVFHV0E0Z05UV3MxMnI4Y0FlR1ZXTmFxenUK",
      "endpoints": [
        "https://github.com/joyworkon/Organize/releases/latest/download/latest.json"
      ]
    }
  }
}
