{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Organize",
  "version": "0.1.0",
  "identifier": "com.organize.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @organize/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @organize/web build",
    "frontendDist": "../apps/web/out"
  },
  "app": {
    "title": "Organize - 智能笔记工具",
    "windows": [
      {
        "title": "Organize",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "global-shortcut": {
      "shortcuts": {
        "CommandOrControl+Shift+S": "quick-save"
      }
    }
  }
}
