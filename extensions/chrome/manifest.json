{
  "manifest_version": 3,
  "name": "Organize 剪藏",
  "short_name": "Organize",
  "description": "把当前网页一键保存到 Organize 稍后读；自动识别页面内的视频 / 音频并支持在线预览。",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 Organize 稍后读"
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
