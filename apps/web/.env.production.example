# ============================================================
# 生产环境环境变量样例（P2-02）。
# 复制为 .env.production（或部署平台的环境变量面板逐项填写）。
# 启动时 instrumentation.ts 会校验：出现 fatal 配置直接拒绝启动。
# ============================================================

# ---- 必须 ----
# Supabase 项目地址（Supabase Dashboard → Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon key（JWT 格式，注意不是 sb_publishable_ 新格式，见 AGENTS.md 陷阱）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- 提醒 Cron（不配置则提醒推送不可用，GitHub 调度会告警）----
# 与 GitHub repo secret CRON_SECRET 相同的值
CRON_SECRET=<random-string>
# 服务端密钥：账号删除 /api/account 与提醒 Cron 必需
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Web Push（不配置则提醒推送不可用）----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public>
VAPID_PRIVATE_KEY=<vapid-private>
VAPID_SUBJECT=mailto:<your-email>

# ---- 红线 ----
# 生产环境严禁设置 true：启动校验会直接拒绝；
# mock 模式会用假数据假成功欺骗真实用户
# NEXT_PUBLIC_MOCK_BACKEND=true
