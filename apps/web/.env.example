NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Only enable when the local outbound network maps public DNS to RFC 2544
# benchmark addresses (for example, a transparent development proxy).
SCRAPER_ALLOW_SYNTHETIC_DNS=false

# Web Push 任务提醒。CRON_SECRET 用于保护 /api/cron/task-reminders。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# AI 服务（可选；用户也可在「设置 › AI 服务」各自配置，用户配置优先）
# 任意 OpenAI 兼容接口：Bearer 鉴权，POST {AI_BASE_URL}/chat/completions
# 例：Xiaomi MiMo → AI_BASE_URL=https://api.xiaomimimo.com/v1，AI_TEXT_MODEL=mimo-v2.6-pro
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
# 本机开了 TUN/Fake-IP 代理（域名解析到 198.18.x.x）时 AI 请求会被 SSRF 防护拦截；
# 设为 true 放行该合成地址段。不设置时沿用 SCRAPER_ALLOW_SYNTHETIC_DNS。
# AI_ALLOW_SYNTHETIC_DNS=false
# 录音转写（/audio/transcriptions），不填则语音相关功能不可用
AI_TRANSCRIPTION_MODEL=
